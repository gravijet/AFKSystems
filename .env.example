# Copy to .env and supply local values.
PORT=3010
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3010
BRAND=AFKSystems
TRUST_PROXY=loopback

# Client repository and optional read token.
CLIENT_REPO=owner/repository
CLIENT_TAG=latest
GITHUB_TOKEN=

ADMIN_EMAIL=
REGISTRATION_OPEN=true
SESSION_DAYS=30
MAX_BOTS_PER_USER=25
MAX_BOTS_TOTAL=200
CHAT_HISTORY_MAX=50000

BANK_HOLDER=
BANK_IBAN=
BANK_BIC=
PAYPAL_ME=
SECRET=
DATA_DIR=
