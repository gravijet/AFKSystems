# Vorlage für .env – die echte Datei gehört nicht ins Repository (siehe .gitignore).

# --- Netz ---------------------------------------------------------------
PORT=3010
HOST=127.0.0.1
PUBLIC_URL=https://example.invalid
BRAND=AFKSystems
# Welche Reverse-Proxies Client-IP-Köpfe setzen dürfen. "loopback" passt zur nginx-Vorlage;
# für Docker oder einen separaten Proxy ausschließlich dessen Netz eintragen, nie pauschal "true".
TRUST_PROXY=loopback

# --- Client -------------------------------------------------------------
# Woher die Client-Dateien kommen. Das Repository ist privat, deshalb braucht es ein Token mit
# Leserecht auf "Contents" (fein abgestuftes PAT genügt).
CLIENT_REPO=gravijet/HugoAFKClient
CLIENT_TAG=latest
GITHUB_TOKEN=

# --- Konten -------------------------------------------------------------
# Wer beim ersten Start Administrator wird. Im Produktionsbetrieb Pflicht, solange noch kein
# Konto existiert: So kann nicht der erste fremde Besucher Administrator werden.
ADMIN_EMAIL=
# Auf false stellen, wenn sich niemand Neues mehr anmelden können soll.
REGISTRATION_OPEN=true
SESSION_DAYS=30

# --- Grenzen ------------------------------------------------------------
MAX_BOTS_PER_USER=25
MAX_BOTS_TOTAL=200
CHAT_HISTORY_MAX=50000

# --- Zahlungen ----------------------------------------------------------
# 1 Credit = 1 Cent, ein Monat = 30 Tage. Preise, Pakete und Tarife stehen in der Datenbank und
# lassen sich im Admin-Bereich ändern.
#
# Karte, PayPal und die übrigen Zahlarten laufen über **Stripe**. Alles dafür – geheimer Schlüssel
# und Signaturgeheimnis des Webhooks – steht in den Einstellungen im Panel und nicht hier: die
# Kasse soll sich einrichten lassen, ohne eine Datei auf dem Server anzufassen (docs/stripe.md).
#
# Dort steht auch die **Umsatzsteuer**: Vorgabe ist die Kleinunternehmerregelung, also kein
# Steueraufschlag und kein Steuerausweis, dafür der Grund als Satz unter jedem Preis.
#
# Überweisung und PayPal von Hand bestätigt der Administrator; dafür stehen die Daten hier.
BANK_HOLDER=
BANK_IBAN=
BANK_BIC=
PAYPAL_ME=

# --- Sonstiges ----------------------------------------------------------
# Wird beim ersten Start selbst erzeugt (data/secret.key), lässt sich hier aber festlegen.
SECRET=
DATA_DIR=
