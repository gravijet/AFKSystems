# Vorlage für .env – die echte Datei gehört nicht ins Repository (siehe .gitignore).

# --- Netz ---------------------------------------------------------------
PORT=3010
HOST=127.0.0.1
PUBLIC_URL=https://afksystems.de
BRAND=AFKSystems

# --- Client -------------------------------------------------------------
# Woher die Client-Dateien kommen. Das Repository ist privat, deshalb braucht es ein Token mit
# Leserecht auf "Contents" (fein abgestuftes PAT genügt).
CLIENT_REPO=gravijet/HugoAFKClient
CLIENT_TAG=latest
GITHUB_TOKEN=

# --- Konten -------------------------------------------------------------
# Wer beim ersten Start Administrator wird. Ohne Angabe: der zuerst registrierte Benutzer.
ADMIN_EMAIL=
# Auf false stellen, wenn sich niemand Neues mehr anmelden können soll.
REGISTRATION_OPEN=true
SESSION_DAYS=30

# --- Grenzen ------------------------------------------------------------
MAX_BOTS_PER_USER=25
MAX_BOTS_TOTAL=200
CHAT_HISTORY_MAX=1000

# --- Zahlungen ----------------------------------------------------------
# 1 Credit = 1 Cent, ein Monat = 30 Tage. Preise, Pakete und Tarife stehen in der Datenbank und
# lassen sich im Admin-Bereich ändern – hier steht nur, wie das Geld hereinkommt.
# Ohne Stripe-Schlüssel bleibt die Kartenzahlung aus; Gutscheine, Überweisung und die Aufbuchung
# durch den Administrator gehen immer.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

BANK_HOLDER=
BANK_IBAN=
BANK_BIC=
PAYPAL_ME=

# --- Sonstiges ----------------------------------------------------------
# Wird beim ersten Start selbst erzeugt (data/secret.key), lässt sich hier aber festlegen.
SECRET=
DATA_DIR=
