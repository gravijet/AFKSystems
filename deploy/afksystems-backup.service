[Unit]
Description=AFKSystems-Sicherung auf einen zweiten Server
Documentation=file:/opt/afksystems/docs/aufbau.md
After=network-online.target afksystems.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/afksystems/backup.conf
ExecStart=/usr/local/sbin/afksystems-backup

User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/afksystems
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
