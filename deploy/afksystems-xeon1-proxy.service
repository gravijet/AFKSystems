[Unit]
Description=AFKSystems Xeon1 SOCKS5 proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
LoadCredential=proxy.password:/etc/afksystems-xeon1-proxy.password
ExecStart=/usr/local/libexec/afksystems-xeon1-proxy
Restart=always
RestartSec=5

# Der Proxy braucht nur Netz und keinerlei Schreibzugriff auf das System.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=afksystems-xeon1-proxy

[Install]
WantedBy=multi-user.target
