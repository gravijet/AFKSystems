# Vorlage für bot/.env – die echte Datei gehört nicht ins Repository.
#
# Der Bot holt sich **alles andere** beim Start aus dem Panel: Server-ID, Kanäle, Rollen, sogar
# seinen eigenen Discord-Token. Hier steht nur, wo das Panel steht und wie er sich dort ausweist.

# Adresse des Panels. Ohne abschließenden Schrägstrich.
PANEL_URL=https://example.invalid

# Dasselbe Geheimnis wie im Panel unter Administration → Einstellungen → Discord.
PANEL_SECRET=

# Nur nötig, wenn der Token nicht im Panel stehen soll (dann hat er hier Vorrang).
BOT_TOKEN=
