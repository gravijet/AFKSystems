# Adresse des Panels. Ohne Schrägstrich am Ende.
PANEL_URL=https://afksystems.de

# Das Token dieses Standorts. Es steht im Panel unter
# Administration -> Standorte -> <Standort> -> Token.
NODE_TOKEN=

# Optional: mehr Bots als hier nimmt dieser Standort nicht an, egal was das Panel schickt.
# 0 (Vorgabe) heißt: es gilt allein die Obergrenze, die im Panel am Standort steht.
AGENT_MAX_JOBS=0

# Optional: wo Client-Dateien und Kontodaten liegen. Vorgabe: ./data neben index.js
# AGENT_DATA_DIR=/opt/afksystems-agent/data
